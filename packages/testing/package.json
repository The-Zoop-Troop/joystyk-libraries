{
  "name": "@joystyk/testing",
  "version": "0.1.0",
  "description": "Dev-time conformance suites for engines and simulations, plus test RNGs, a fake clock, fake storage and fixture builders.",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./fixtures": "./src/fixtures/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node ../../scripts/build-package.ts",
    "prepack": "node ../../scripts/build-package.ts"
  },
  "dependencies": {
    "@joystyk/contracts": "workspace:*",
    "@joystyk/kit": "workspace:*",
    "@joystyk/session": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./fixtures": {
        "types": "./dist/fixtures/index.d.ts",
        "default": "./dist/fixtures/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Zoop-Troop/joystyk-libraries.git",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/The-Zoop-Troop/joystyk-libraries/tree/main/packages/testing#readme",
  "bugs": {
    "url": "https://github.com/The-Zoop-Troop/joystyk-libraries/issues"
  }
}
