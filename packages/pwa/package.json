{
  "name": "@joystyk/pwa",
  "version": "0.1.0",
  "description": "The Joystyk PWA: the service worker and its cache tiers, offline pinning, update prompts at safe points, the kill switch, and the build step that emits sw.js and the asset manifests.",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
    "./build": "./src/build/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "build": "node ../../scripts/build-package.ts",
    "prepack": "node ../../scripts/build-package.ts"
  },
  "dependencies": {
    "@joystyk/contracts": "workspace:*",
    "@joystyk/daily": "workspace:*",
    "@joystyk/storage": "workspace:*",
    "workbox-core": "catalog:",
    "workbox-expiration": "catalog:",
    "workbox-precaching": "catalog:",
    "workbox-routing": "catalog:",
    "workbox-strategies": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "./build": {
        "types": "./dist/build/index.d.ts",
        "default": "./dist/build/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "vite": "catalog:"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Zoop-Troop/joystyk-libraries.git",
    "directory": "packages/pwa"
  },
  "homepage": "https://github.com/The-Zoop-Troop/joystyk-libraries/tree/main/packages/pwa#readme",
  "bugs": {
    "url": "https://github.com/The-Zoop-Troop/joystyk-libraries/issues"
  }
}
