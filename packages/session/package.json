{
  "name": "@joystyk/session",
  "version": "0.2.0",
  "description": "Session runners: the local runner for discrete engines, the fixed-step scheduler for simulations and the remote client for server rooms, behind ports with browser adapters.",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser/index.ts",
    "./browser/rooms": "./src/browser/rooms.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json",
    "build": "node ../../scripts/build-package.ts",
    "prepack": "node ../../scripts/build-package.ts"
  },
  "dependencies": {
    "@joystyk/contracts": "workspace:*",
    "@joystyk/kit": "workspace:*",
    "@joystyk/rooms": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./browser": {
        "types": "./dist/browser/index.d.ts",
        "default": "./dist/browser/index.js"
      },
      "./browser/rooms": {
        "types": "./dist/browser/rooms.d.ts",
        "default": "./dist/browser/rooms.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joystyk-games/game-libraries.git",
    "directory": "packages/session"
  },
  "homepage": "https://github.com/joystyk-games/game-libraries/tree/main/packages/session#readme",
  "bugs": {
    "url": "https://github.com/joystyk-games/game-libraries/issues"
  }
}
